{
  "manifest_version": 3,
  "name": "ChatGPT User Chat Extractor",
  "version": "0.1.0",
  "description": "Detect AI hallucinations in a single click.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "Detect AI hallucinations"
  },
  "background": {
    "service_worker": "background.js"
  }
}
