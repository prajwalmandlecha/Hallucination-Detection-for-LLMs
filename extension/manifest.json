{
  "manifest_version": 3,
  "name": "AI Chat Extractor",
  "version": "0.3.0",
  "description": "Detect AI hallucinations in ChatGPT, Gemini, Claude, and DeepSeek conversations with one click.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt-attachment-observer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini-attachment-observer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "claude-attachment-observer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "deepseek-attachment-observer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Detect AI hallucinations"
  },
  "background": {
    "service_worker": "background.js"
  }
}